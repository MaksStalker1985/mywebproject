# TechVault: gunicorn (Django). Устанавливается в /etc/systemd/system/django-site.service
# Слушает сокет из django-site.socket (/run/django-site.sock).
[Unit]
Description=TechVault (Django + gunicorn)
Requires=django-site.socket
After=network.target django-site.socket postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=techvault
# Группа www-data: nginx читает загруженные файлы и статику
Group=www-data
UMask=0027
WorkingDirectory=/var/www/django-site
EnvironmentFile=/etc/techvault/techvault.env
ExecStart=/var/www/django-site/venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --timeout 120 \
    --max-requests 1000 --max-requests-jitter 100 \
    --access-logfile - \
    --forwarded-allow-ips="*"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# Ограничения: сервис может писать только в media
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/django-site/media
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
