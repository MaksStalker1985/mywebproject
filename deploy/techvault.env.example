# Переменные окружения TechVault. На сервере: /etc/techvault/techvault.env (права 640, root:techvault).
# install.sh создаёт этот файл сам и генерирует секреты; здесь — справочник всех параметров.
# Значения с пробелами берите в двойные кавычки.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=сгенерируйте-длинную-случайную-строку
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# 1 — перенаправлять на HTTPS и ставить cookie только по HTTPS (включите после получения сертификата)
DJANGO_SECURE_SSL_REDIRECT=1
# HSTS: после проверки, что HTTPS работает, увеличьте до 31536000 (год)
DJANGO_HSTS_SECONDS=3600

DJANGO_STATIC_ROOT=/var/www/django-site/staticfiles
DJANGO_MEDIA_ROOT=/var/www/django-site/media
# Установочные файлы отдаёт nginx после проверки покупки (см. location /protected-media/ в nginx)
DJANGO_DOWNLOADS_ACCEL_PREFIX=/protected-media

# PostgreSQL (пустой POSTGRES_HOST — локальный сокет)
POSTGRES_DB=techvault
POSTGRES_USER=techvault
POSTGRES_PASSWORD=сгенерируйте-пароль
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Общий кеш для процессов gunicorn (лимиты сброса пароля)
REDIS_URL=redis://127.0.0.1:6379/1

# Почта (сброс пароля, форма связи). Настроено для Hostinger Mail: SSL на порту 465.
# support@ — алиас: письма уходят от его имени и приходят на него, но войти в SMTP через алиас
# нельзя. EMAIL_HOST_USER и EMAIL_HOST_PASSWORD — адрес и пароль настоящего почтового ящика,
# к которому привязан алиас. install.sh спрашивает их при установке; в git их не храните.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Отправитель писем и адрес для ответов — алиас поддержки
DEFAULT_FROM_EMAIL="TechVault <support@example.com>"
EMAIL_REPLY_TO=support@example.com
# Куда пересылаются сообщения из формы связи
CONTACT_EMAIL=support@example.com

# Платежи: stripe или paddle (demo при DJANGO_DEBUG=0 отключён)
PAYMENTS_PROVIDER=paddle
PAYMENTS_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_SANDBOX=0
