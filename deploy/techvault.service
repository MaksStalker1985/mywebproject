# systemd-сервис: gunicorn для TechVault. Устанавливается в /etc/systemd/system/techvault.service
[Unit]
Description=TechVault (Django + gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=techvault
# Группа www-data: nginx читает сокет и загруженные файлы
Group=www-data
UMask=0027
WorkingDirectory=/srv/techvault/app
EnvironmentFile=/etc/techvault/techvault.env
RuntimeDirectory=techvault
RuntimeDirectoryMode=0750
ExecStart=/srv/techvault/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/techvault/gunicorn.sock \
    --workers 3 \
    --timeout 120 \
    --max-requests 1000 --max-requests-jitter 100 \
    --access-logfile - \
    --forwarded-allow-ips="*"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# Ограничения: сервис может писать только в media
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/techvault/media
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
